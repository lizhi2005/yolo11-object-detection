            <property name="styleSheet">
             <string notr="true">QComboBox#comboBox {
    background-color: rgba(249, 224, 118, 0.65);
    border: 1px solid rgba(249, 224, 118, 0.5);
    border-radius: 25px;
    padding: 14px;
    font-size: 17px;
    font-weight: bold;
    color: #5D4037;
}

QComboBox#comboBox:hover {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(249, 224, 118, 0.5);
    color: #5D4037;
}

QComboBox#comboBox:pressed {
    background-color: rgba(255, 220, 100, 0.8);
    border: 1px solid rgba(249, 224, 118, 0.5);
    color: #5D4037;
}

/* 下拉箭头样式，匹配登录按钮风格 */
QComboBox#comboBox::drop-down {
    border: none;
    width: 30px;
    height: 30px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
}

QComboBox#comboBox::down-arrow {
    width: 16px;
    height: 16px;
    color: #5D4037;
}</string>
