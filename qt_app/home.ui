            <property name="styleSheet">
             <string notr="true">
#pushButtoncapture {
    /* 默认：和登录按钮完全一致 */
    background-color: rgba(249, 224, 118, 0.65);
    border: 1px solid rgba(249, 224, 118, 0.5);
    border-radius: 25px;
    padding: 14px;
    font-size: 17px;
    font-weight: bold;
    color: #5D4037;
    text-align: center;
}

/* 鼠标悬浮：只显示底图，文字消失，图片变淡 */
#pushButtoncapture:hover {
    border-image: url(:/image/82.png);
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 25px;
    /* 关键：文字完全透明，等于消失 */
    color: rgba(0, 0, 0, 0);
    font-size: 0px;
}

/* 鼠标按下：保持底图，无文字 */
#pushButtoncapture:pressed {
    border-image: url(:/image/82.png);
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 25px;
    color: rgba(0, 0, 0, 0);
    font-size: 0px;
}</string>
